# ============================================================
# FamilyConnect — Environment Variables Reference
# Copy this file to .env and fill in values as needed.
# In Docker Compose, these are already set via the 'environment'
# block in docker-compose.yml so you don't need a .env file
# unless you're running the backend outside of Docker.
# ============================================================

# ── PostgreSQL ───────────────────────────────────────────────
DATABASE_URL=postgresql://familyconnect:familypassword@db:5432/familyconnect_db

# ── JWT Auth ─────────────────────────────────────────────────
JWT_SECRET_KEY=supersecretkey12345
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ── External Mock Government Services ────────────────────────
# These point to Docker service names (resolved internally).
# Change to http://localhost:8001 / http://localhost:8002
# if running the backend outside of Docker.
AADHAAR_SERVICE_URL=http://mock-aadhaar:8000
RATION_SERVICE_URL=http://mock-ration:8000

# ── Mock Aadhaar Service ─────────────────────────────────────
# (Only needed inside the mock-aadhaar container)
# SERVICE_NAME=Mock Aadhaar Identity Service
# DATA_PATH=/app/data/citizens.json

# ── Mock Ration Service ───────────────────────────────────────
# (Only needed inside the mock-ration container)
# SERVICE_NAME=Mock Ration Household Service
# DATA_PATH=/app/data/households.json
